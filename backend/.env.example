# Provided automatically by Vercel once Postgres (Neon) is connected to
# this project (Storage tab -> Create Database -> Postgres). For local dev
# with `vercel env pull .env.local`, or copy it manually from the dashboard.
POSTGRES_URL="postgres://..."

# Comma-separated list of frontend origins allowed to call this API.
# Example: https://quanlydubi-frontend.vercel.app,http://localhost:3000
ALLOWED_ORIGINS="http://localhost:3000"

PORT=4000
